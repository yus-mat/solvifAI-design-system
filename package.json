{
  "name": "solvifai-v2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "storybook": "STORYBOOK_INCLUDE_PAGES=true storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build-storybook:pages": "STORYBOOK_BASE_PATH=/solvifAI-design-system/ storybook build",
    "build-storybook:local": "STORYBOOK_INCLUDE_PAGES=true storybook build",
    "prebuild-storybook": "npm run tokens:build && npm run manifest:build",
    "tokens:build": "style-dictionary build --config style-dictionary.config.mjs && node scripts/generate-primitive-colors.mjs",
    "manifest:build": "node scripts/generate-manifest.mjs",
    "predev": "npm run tokens:build && npm run manifest:build",
    "prebuild": "npm run tokens:build && npm run manifest:build",
    "prestorybook": "npm run tokens:build && npm run manifest:build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "lucide-react": "^1.17.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.4.6",
    "@storybook/react-vite": "10.4.6",
    "@tailwindcss/vite": "^4.1.8",
    "@types/node": "^22.19.19",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "react-docgen-typescript": "^2.4.0",
    "storybook": "10.4.6",
    "style-dictionary": "^4.3.0",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
