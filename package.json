{
  "name": "@sola/design-system",
  "version": "0.2.2",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./theme.css": "./dist/theme.css",
    "./manifest.json": "./dist/manifest.json",
    "./mcp-server.mjs": "./dist/mcp-server.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "npm run tokens:build && npm run manifest:build && vite build --config vite.lib.config.ts && node scripts/build-lib-extras.mjs",
    "preview": "vite preview",
    "storybook": "STORYBOOK_INCLUDE_PAGES=true storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build-storybook:pages": "STORYBOOK_BASE_PATH=/solvifAI-design-system/ storybook build",
    "build-storybook:local": "STORYBOOK_INCLUDE_PAGES=true storybook build",
    "prebuild-storybook": "npm run tokens:build && npm run manifest:build",
    "tokens:build": "style-dictionary build --config style-dictionary.config.mjs && node scripts/generate-primitive-colors.mjs",
    "manifest:build": "node scripts/generate-manifest.mjs",
    "predev": "npm run tokens:build && npm run manifest:build",
    "prebuild": "npm run tokens:build && npm run manifest:build",
    "prestorybook": "npm run tokens:build && npm run manifest:build",
    "prepare": "npm run build:lib"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@phosphor-icons/react": "^2.1.10",
    "playwright": "^1.62.1",
    "react-router-dom": "^7.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.4.6",
    "@storybook/react-vite": "10.4.6",
    "@tailwindcss/vite": "^4.1.8",
    "@types/node": "^22.19.19",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "react": "^19.1.0",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "^19.1.0",
    "storybook": "10.4.6",
    "style-dictionary": "^4.3.0",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^5.0.3"
  }
}
